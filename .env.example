# Active payment network for ZapCast.
# Supported values: botchain-mainnet, botchain-testnet
# Defaults to botchain-mainnet when this variable or the entire .env file is absent.
ZAPCAST_PAYMENT_NETWORK=botchain-mainnet

# Optional BOT/USDT market-price endpoint used for approximate USD displays.
ZAPCAST_BOT_PRICE_URL=https://api.coinstore.com/api/v1/ticker/price;symbol=BOTUSDT
